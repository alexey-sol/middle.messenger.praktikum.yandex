{
    "name": "middle.messenger.praktikum.yandex",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "npm": ">=11.0.0 <12.0.0",
        "node": ">=24.0.0 <25.0.0"
    },
    "scripts": {
        "start": "vite --config vite.config.ts",
        "build": "tsc && vite build --config vite.config.ts",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "lint:pre-commit": "npm run lint:fix",
        "stylelint": "stylelint \"**/*.{css,scss}\"",
        "stylelint:fix": "npm run stylelint -- --fix",
        "stylelint:pre-commit": "npm run stylelint:fix",
        "pre-commit": "lint-staged",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,mjs,ts,json}": [
            "npm run lint:pre-commit"
        ],
        "*.{css,scss}": [
            "npm run stylelint:pre-commit"
        ]
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@types/node": "25.6.0",
        "@typescript-eslint/eslint-plugin": "8.59.0",
        "eslint": "9.39.4",
        "eslint-config-canonical": "47.4.2",
        "eslint-import-resolver-typescript": "4.4.4",
        "husky": "9.1.7",
        "jsdom": "29.0.2",
        "lint-staged": "16.4.0",
        "prettier": "3.8.3",
        "sass": "1.99.0",
        "stylelint": "17.9.1",
        "stylelint-config-standard-scss": "17.0.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "8.59.0",
        "vite": "8.0.10",
        "vitest": "4.1.5"
    },
    "dependencies": {
        "handlebars": "4.7.9",
        "vite-plugin-handlebars": "2.0.3"
    }
}
