<form class="auth-form" id="auth-form" novalidate>
    <div class="auth-form__rows">
        {{#each fields}}
            {{{
                FloatingInput
                    disabled=this.disabled
                    label=this.label
                    name=this.name
                    ref=this.ref
                    type=this.type
            }}}
        {{/each}}
    </div>
</form>
