<div class="input {{variantClassName}} {{#if className}}{{className}}{{/if}}" data-component>
    <div class="{{variantClassName}}__wrapper">
        <label class="{{variantClassName}}__label" for="{{name}}">
            {{label}}
        </label>

        <input
            class="input__field {{variantClassName}}__field"
            id="{{name}}"
            name="{{name}}"
            placeholder="{{placeholder}}"
            type="{{type}}"
            value="{{value}}"
            {{#if disabled}}disabled{{/if}}
            {{#if ref}}ref="{{ref}}"{{/if}}
        >
    </div>

    <p class="input__error-message" data-error>{{error}}</p>
</div>
