<div class="input {{#if variant}}input--{{variant}}-variant{{/if}}">
    <label class="input__label {{#if value}}input__label--shrink{{/if}}">
        {{label}}
    </label>

    <input
        class="input__field"
        id="{{name}}"
        name="{{name}}"
        type="{{type}}"
        value="{{value}}"
        {{#if disabled}}disabled{{/if}}
        {{#if required}}required{{/if}}
    >
</div>
