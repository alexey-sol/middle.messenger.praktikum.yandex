<div class="input" data-component>
    <div class="input__wrapper">
        <label class="input__label" for="{{name}}">
            {{label}}
        </label>

        <input
            class="input__field"
            id="{{name}}"
            name="{{name}}"
            placeholder="{{placeholder}}"
            type="{{type}}"
            value="{{value}}"
            {{#if disabled}}disabled{{/if}}
            {{#if ref}}ref="{{ref}}"{{/if}}
        >
    </div>

    <p class="input__error-message" data-error>{{error}}</p>
</div>
