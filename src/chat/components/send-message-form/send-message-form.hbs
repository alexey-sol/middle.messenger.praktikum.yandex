<form class="send-message-form" novalidate>
    {{!-- TODO пока не реализованы прикрепы --}}
    {{!-- <div class="chat-attach">
        <button class="chat-attach__btn" type="button" aria-label="Прикрепить файл">
            <img src="/assets/icons/attach.svg" alt="Прикрепить файл">
        </button>

        {{> dropdown class="chat-attach__dropdown" items=attachDropdownItems }}
    </div> --}}

    {{#each fields}}
        <input
            class="send-message-form__input"
            name={{this.name}}
            placeholder={{this.placeholder}}
            type={{this.type}}
            aria-label="Ввод сообшения"
        />
    {{/each}}

    <button class="send-message-form__send-btn" type="submit" aria-label="Отправить сообщение">
        <img src="/assets/icons/send.svg" alt="Отправить сообщение">
    </button>
</form>
