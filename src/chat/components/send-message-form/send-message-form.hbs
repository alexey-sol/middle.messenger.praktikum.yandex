<form class="send-message-form" novalidate>
    <div class="chat-attach">
        <button class="chat-attach__btn">
            <img src="/assets/icons/attach.svg" alt="Attach file">
        </button>

        {{> dropdown class="chat-attach__dropdown" items=attachDropdownItems }}
    </div>

    {{#each fields}}
        <input
            class="send-message-form__input"
            name={{this.name}}
            placeholder={{this.placeholder}}
            type={{this.type}}
        />
    {{/each}}

    <button class="send-message-form__send-btn" type="submit">
        <img src="/assets/icons/send.svg" alt="Send message">
    </button>
</form>
