<section class="chat-window">
    <header class="chat-header">
        <div class="chat-header__wrapper">
            <div class="chat-header__info">
                <div class="chat-header__avatar"></div>
                <button class="opened-chat-avatar" data-case="update-avatar" aria-label="Открыть окно обновления аватара" type="button">
                    <img class="opened-chat-avatar__image" src={{#if openedChat.data.avatar}}"{{{getResourceUrl openedChat.data.avatar}}}"{{else}}"/assets/icons/default-avatar.svg"{{/if}} alt="{{this.title}}" id="avatar-preview">
                </button>
                <span class="chat-header__name">{{openedChat.data.title}}</span>
            </div>

            <div class="chat-settings">
                <button class="chat-settings__btn" aria-label="Открыть меню чата" type="button">
                    <img src="/assets/icons/settings.svg" alt="Settings">
                </button>

                {{> dropdown class="chat-settings__dropdown" items=settingsDropdownItems }}
            </div>
        </div>
    </header>

    <div class="chat-feed">
        {{#each (reverse openedChatMessages)}}
            {{#if (isLastTimeOccurrence this ../openedChatMessages)}}
                <p class="chat-feed__message-date">{{formatChatMessageDate this.time}}</p>
            {{/if}}

            {{{
                MessageItem
                    content=this.content
                    isRead=this.is_read
                    isOutgoing=(eq this.user_id ../user.id)
                    isSystem=(eq this.type "user connected")
                    time=this.time
                    userId=this.user_id
            }}}
        {{/each}}
    </div>

    <footer class="chat-footer">
        {{{
            SendMessageForm
                attachDropdownItems=attachDropdownItems
                fields=fields
                onSubmit=onSubmit
                validators=validators
        }}}
    </footer>
</section>
