<form class="profile-form" id="profile-form" novalidate>
    <div class="profile-content">
        <div class="profile-header">
            <label class="profile-avatar" for="avatar-upload">
                <img src="/assets/icons/default-avatar.svg" alt="{{displayName}}" id="avatar-preview">
                <input class="profile-avatar__input" type="file" id="avatar-upload" name="avatar" accept="image/*">
            </label>

            <h1 class="profile-header__name">{{displayName}}</h1>
        </div>

        <div class="profile-rows">
            {{#each fields}}
                {{{
                    Input
                        disabled=this.disabled
                        label=this.label
                        name=this.name
                        type=this.type
                        value=this.value
                        variant="inline"
                }}}
            {{/each}}
        </div>
    </div>
</form>
